{"ast":null,"code":"```jsx\nimport React, { useState } from \"react\";\n\nexport default function Progress() {\n\n  const [selected, setSelected] = useState(\"\");\n\n  return (\n\n    <div\n      style={{\n        minHeight: \"100vh\",\n        background: \"#f1f5f9\",\n        padding: \"40px\"\n      }}\n    >\n\n      <h1\n        style={{\n          textAlign: \"center\",\n          color: \"#0f172a\",\n          fontSize: \"45px\"\n        }}\n      >\n\n        Student Progress Dashboard\n\n      </h1>\n\n      <p\n        style={{\n          textAlign: \"center\",\n          color: \"gray\",\n          marginBottom: \"40px\"\n        }}\n      >\n\n        Track Your Academic Progress & Skills\n\n      </p>\n\n\n\n      <div\n\n        style={{\n\n          display: \"grid\",\n\n          gridTemplateColumns:\n\n          \"repeat(auto-fit,minmax(250px,1fr))\",\n\n          gap: \"25px\"\n\n        }}\n\n      >\n\n        <div\n\n          style={blueCard}\n\n          onClick={() => setSelected(\"courses\")}\n\n        >\n\n          <h2>📚 Courses</h2>\n\n          <h1>8</h1>\n\n          <p>Completed Courses</p>\n\n        </div>\n\n\n\n        <div\n\n          style={greenCard}\n\n          onClick={() => setSelected(\"score\")}\n\n        >\n\n          <h2>🏆 Score</h2>\n\n          <h1>92%</h1>\n\n          <p>Overall Performance</p>\n\n        </div>\n\n\n\n        <div\n\n          style={orangeCard}\n\n          onClick={() => setSelected(\"attendance\")}\n\n        >\n\n          <h2>🔥 Attendance</h2>\n\n          <h1>96%</h1>\n\n          <p>Current Attendance</p>\n\n        </div>\n\n\n\n        <div\n\n          style={pinkCard}\n\n          onClick={() => setSelected(\"skills\")}\n\n        >\n\n          <h2>⭐ Skills</h2>\n\n          <h1>15</h1>\n\n          <p>Skills Learned</p>\n\n        </div>\n\n      </div>\n\n\n\n      {\n\n        selected === \"courses\" &&\n\n        <div style={detailBox}>\n\n          <h2>Completed Courses</h2>\n\n          <table style={tableStyle}>\n\n            <thead>\n\n              <tr>\n\n                <th>Course</th>\n\n                <th>Status</th>\n\n                <th>Progress</th>\n\n              </tr>\n\n            </thead>\n\n            <tbody>\n\n              <tr>\n\n                <td>Java Full Stack</td>\n\n                <td>Completed</td>\n\n                <td>85%</td>\n\n              </tr>\n\n              <tr>\n\n                <td>React JS</td>\n\n                <td>Completed</td>\n\n                <td>75%</td>\n\n              </tr>\n\n              <tr>\n\n                <td>PostgreSQL</td>\n\n                <td>Completed</td>\n\n                <td>90%</td>\n\n              </tr>\n\n            </tbody>\n\n          </table>\n\n        </div>\n\n      }\n\n\n\n      {\n\n        selected === \"score\" &&\n\n        <div style={detailBox}>\n\n          <h2>Performance Details</h2>\n\n          <h3>Overall Score : 92%</h3>\n\n          <progress\n\n            value=\"92\"\n\n            max=\"100\"\n\n            style={progressBar}\n\n          />\n\n          <p>\n\n            Excellent performance in academics\n\n          </p>\n\n        </div>\n\n      }\n\n\n\n      {\n\n        selected === \"attendance\" &&\n\n        <div style={detailBox}>\n\n          <h2>Attendance Details</h2>\n\n          <p>Total Classes : 120</p>\n\n          <p>Attended Classes : 115</p>\n\n          <p>Attendance Percentage : 96%</p>\n\n          <progress\n\n            value=\"96\"\n\n            max=\"100\"\n\n            style={progressBar}\n\n          />\n\n        </div>\n\n      }\n\n\n\n      {\n\n        selected === \"skills\" &&\n\n        <div style={detailBox}>\n\n          <h2>Skills Learned</h2>\n\n          <ul>\n\n            <li>Java</li>\n\n            <li>React JS</li>\n\n            <li>Node JS</li>\n\n            <li>PostgreSQL</li>\n\n            <li>HTML & CSS</li>\n\n            <li>JavaScript</li>\n\n          </ul>\n\n        </div>\n\n      }\n\n    </div>\n\n  );\n\n}\n\n\n\nconst detailBox = {\n\n  background: \"white\",\n\n  marginTop: \"40px\",\n\n  padding: \"30px\",\n\n  borderRadius: \"20px\",\n\n  boxShadow:\n\n  \"0 10px 25px rgba(0,0,0,0.1)\"\n\n};\n\n\n\nconst tableStyle = {\n\n  width: \"100%\",\n\n  borderCollapse: \"collapse\",\n\n  textAlign: \"center\"\n\n};\n\n\n\nconst progressBar = {\n\n  width: \"100%\",\n\n  height: \"25px\"\n\n};\n\n\n\nconst blueCard = {\n\n  background: \"#2563eb\",\n\n  color: \"white\",\n\n  padding: \"30px\",\n\n  borderRadius: \"20px\",\n\n  textAlign: \"center\",\n\n  cursor: \"pointer\"\n\n};\n\n\n\nconst greenCard = {\n\n  background: \"#16a34a\",\n\n  color: \"white\",\n\n  padding: \"30px\",\n\n  borderRadius: \"20px\",\n\n  textAlign: \"center\",\n\n  cursor: \"pointer\"\n\n};\n\n\n\nconst orangeCard = {\n\n  background: \"#f59e0b\",\n\n  color: \"white\",\n\n  padding: \"30px\",\n\n  borderRadius: \"20px\",\n\n  textAlign: \"center\",\n\n  cursor: \"pointer\"\n\n};\n\n\n\nconst pinkCard = {\n\n  background: \"#ec4899\",\n\n  color: \"white\",\n\n  padding: \"30px\",\n\n  borderRadius: \"20px\",\n\n  textAlign: \"center\",\n\n  cursor: \"pointer\"\n\n};\n```;","map":{"version":3,"names":[],"sources":["C:/Users/BHAGYALAKSHMI/Downloads/RBAC-Full-Project/frontend/src/pages/Progress.js"],"sourcesContent":["```jsx\r\nimport React, { useState } from \"react\";\r\n\r\nexport default function Progress() {\r\n\r\n  const [selected, setSelected] = useState(\"\");\r\n\r\n  return (\r\n\r\n    <div\r\n      style={{\r\n        minHeight: \"100vh\",\r\n        background: \"#f1f5f9\",\r\n        padding: \"40px\"\r\n      }}\r\n    >\r\n\r\n      <h1\r\n        style={{\r\n          textAlign: \"center\",\r\n          color: \"#0f172a\",\r\n          fontSize: \"45px\"\r\n        }}\r\n      >\r\n\r\n        Student Progress Dashboard\r\n\r\n      </h1>\r\n\r\n      <p\r\n        style={{\r\n          textAlign: \"center\",\r\n          col